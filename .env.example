# ============================================================
#  量化交易平台 - 环境变量配置模板
#  用法: 复制本文件为 .env  (命令: copy .env.example .env)
#  然后把下面的 key 填上, 启动时会自动加载, 无需手动 set 环境变量。
#  .env 已在 .gitignore 中, 不会被提交, 密钥安全。
# ============================================================

# ---- 大模型 API Key (多智能体 / AI 策略在线决策必需) ----
# DeepSeek: 到 https://platform.deepseek.com 注册充值后创建
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选: 通义千问 (DashScope) 备用模型
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---- 通知服务 (可选) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DINGTALK_WEBHOOK=
# WECOM_WEBHOOK=
